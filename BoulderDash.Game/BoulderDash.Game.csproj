<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Icon.ico" />
    <None Remove="Icon.bmp" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Icon.ico">
      <LogicalName>Icon.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Icon.bmp">
      <LogicalName>Icon.bmp</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <!-- Keine Content-Pipeline (kein MGCB): Assets werden zur Laufzeit direkt geladen, siehe Assets/.
         Alle Assets sind menschenlesbare Textdateien: Caves in Assets/Caves/ (CaveTextFile.cs),
         Sprites in Assets/Sprites/ (eine Datei pro Objekt, SpriteTextFile.cs), die Demo in
         Assets/demo.txt (DemoTextFile.cs, jeweils BoulderDash.Core/Data/). Sound wird
         vollständig synthetisiert (BoulderDash.Core/Audio), keine Audiodateien nötig.

         Die Version ist FESTGENAGELT (kein 3.8.*): Das kompilierte Shaderformat (.mgfxo, siehe
         CompileShaders) ist versioniert — Shader-Compiler und Framework müssen dieselbe Version
         sprechen, sonst wirft Effect beim Laden. Beim Anheben also beides gemeinsam heben: hier
         und in .config/dotnet-tools.json. -->
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.4.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\BoulderDash.Core\BoulderDash.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
    <ShaderSource Include="Effects\*.fx" />
  </ItemGroup>
  <!-- Shader werden mit mgfxc übersetzt (dotnet-Tool, siehe .config/dotnet-tools.json) — die einzige
       Ausnahme von "alle Assets sind Textdateien": Die HLSL-Quelle in Effects/ ist lesbar und liegt im
       Repo, das binäre .mgfxo entsteht beim Bauen in obj/ und wird von dort ins Ausgabeverzeichnis
       kopiert. Der Übersetzungsschritt braucht den D3D-Compiler und läuft deshalb nur unter Windows
       (anderswo bräuchte mgfxc Wine, siehe MGFXC_WINE_PATH). -->
  <PropertyGroup>
    <!-- Absolut, weil mgfxc aus dem Projektverzeichnis heraus läuft (relative Pfade bezöge es auf sein
         eigenes Arbeitsverzeichnis). BaseIntermediateOutputPath (obj\) und NICHT IntermediateOutputPath
         (obj\Debug\net10.0\): Letzteres setzt das SDK erst in seinen Targets am Dateiende, hier wäre es
         noch leer — und das kompilierte .mgfxo landete neben seiner Quelle im Quellbaum. Die
         Konfiguration ist ihm ohnehin gleich, ein Shader wird nicht im Debug anders übersetzt. -->
    <ShaderOutputDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)Effects'))</ShaderOutputDir>
  </PropertyGroup>
  <Target Name="CompileShaders" BeforeTargets="AssignTargetPaths"
          Inputs="@(ShaderSource)"
          Outputs="@(ShaderSource->'$(ShaderOutputDir)\%(Filename).mgfxo')">
    <MakeDir Directories="$(ShaderOutputDir)" />
    <Exec Command="dotnet tool restore" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <!-- mgfxc zielt auf eine ältere Runtime als das net10-SDK dieser Maschine. -->
    <Exec Command="dotnet tool run mgfxc &quot;%(ShaderSource.FullPath)&quot; &quot;$(ShaderOutputDir)\%(ShaderSource.Filename).mgfxo&quot; /Profile:OpenGL"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          EnvironmentVariables="DOTNET_ROLL_FORWARD=Major" />
  </Target>
  <!-- Eigenes Target, damit die übersetzten Shader auch dann in den Build kommen, wenn CompileShaders
       als aktuell übersprungen wurde — AfterTargets feuert auch dann. -->
  <Target Name="IncludeShaders" AfterTargets="CompileShaders" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <None Include="@(ShaderSource->'$(ShaderOutputDir)\%(Filename).mgfxo')"
            TargetPath="Effects\%(Filename).mgfxo"
            CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>